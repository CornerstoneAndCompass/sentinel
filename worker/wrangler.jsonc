{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-feeds",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AIS_HUB",
        "class_name": "AisHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AisHub"]
    }
  ]
}
