{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-feeds",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // The spine samples every 15 minutes. That is fine-grained enough for the
  // 7-day medians to mean something and coarse enough that a day of history is
  // 96 rows, which KV holds comfortably as one value per day.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // caches.default is per-datacenter, so a cache warmed in one colo does
  // nothing for a client hitting another. KV is globally replicated, which is
  // what a heavily-throttled upstream like GDELT actually needs. The spine
  // shares this namespace under a `spine:` prefix so it needs no new binding.
  "kv_namespaces": [
    {
      "binding": "FEED_CACHE",
      "id": "524df388794b470ab82034c599c068f2"
    }
  ],
  // v2 drops AisHub. Removing a Durable Object class requires an explicit
  // deleted_classes migration; without it the deploy fails rather than
  // silently orphaning the class.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AisHub"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["AisHub"]
    }
  ]
}
